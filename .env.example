# Chỉ dùng cho local. Sao chép thành .env; không commit .env.
POSTGRES_DB=yiedu
POSTGRES_USER=yiedu
POSTGRES_PASSWORD=local_only_password
DATABASE_URL=postgresql+psycopg://yiedu:local_only_password@localhost:5432/yiedu
# Đổi bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-random-local-key-at-least-32-chars
